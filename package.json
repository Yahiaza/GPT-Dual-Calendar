{
  "name": "gpt-dual-calendar",
  "version": "1.0.14",
  "private": true,
  "description": "Desktop dual Gregorian/Hijri calendar with reminders and date difference tools.",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && electron-builder",
    "build:renderer": "vite build",
    "start": "electron .",
    "build:portable": "vite build && electron-builder --win portable",
    "build:unpacked": "vite build && electron-builder --win dir",
    "bump:version": "node scripts/bump-version.cjs",
    "prebuild": "npm run bump:version",
    "prebuild:portable": "npm run bump:version",
    "prebuild:unpacked": "npm run bump:version"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "moment": "^2.30.1",
    "moment-hijri": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "26.15.7",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.gptdualcalendar.app",
    "productName": "GPT Dual Calendar",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GPT-Dual-Calendar-${version}-Portable.${ext}",
      "icon": "build/icon.ico",
      "signExecutable": false,
      "forceCodeSigning": false
    },
    "compression": "store",
    "portable": {
      "unpackDirName": "GPTDualCalendarPortable",
      "useZip": true,
      "requestExecutionLevel": "user"
    }
  },
  "type": "module"
}
